generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequirementType {
  USER_STORY
}
enum RequirementStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum RelationType {
  RELATED_TO
  DEPENDS_ON
  BLOCKS
  CONFLICTS_WITH
}
enum ImpactStatus {
  PENDING
  COMPLETED
  FAILED
}
enum ImpactDecision {
  PENDING
  CONFIRMED
  DISMISSED
}
enum AiSuggestionType {
  RELATION
  REFERENCE
}
enum AiSuggestionStatus {
  PENDING
  CONFIRMED
  DISMISSED
}
enum DependencyAnalysisStatus {
  QUEUED
  READING
  PERSISTING
  COMPLETED
  FAILED
}
enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}
enum ReferenceType {
  PROTOTYPE
  ATTACHMENT
}
enum CommentThreadStatus {
  OPEN
  RESOLVED
}
enum NotificationType {
  MENTION
}
enum IntegrationKind {
  GITHUB
  GOOGLE
}
enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
}
enum IntegrationCandidateStatus {
  PENDING
  ACCEPTED
  DISMISSED
}
enum IntegrationCandidateChangeType {
  CREATED
  UPDATED
  REMOVED
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum GoogleDriveOutboxOperation {
  CREATE
  UPDATE
  MOVE
  ARCHIVE
}

enum GoogleDriveOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  memberships WorkspaceMember[]
  activities ActivityLog[]
  commentThreads CommentThread[] @relation("commentThreadAuthor")
  resolvedCommentThreads CommentThread[] @relation("commentThreadResolver")
  commentMessages CommentMessage[]
  notifications Notification[]
  googleOAuthStates GoogleOAuthState[]
  sessions AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  legalAcceptances LegalAcceptance[]
  sentInvites WorkspaceInvite[] @relation("inviteSender")
  receivedInvites WorkspaceInvite[] @relation("inviteRecipient")
}
model Workspace {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  members WorkspaceMember[]
  projects Project[]
  templates DocumentTemplate[]
  folders RequirementFolder[]
  integrations IntegrationConnection[]
  googleOAuthStates GoogleOAuthState[]
  invites WorkspaceInvite[]
}

model AuthSession {
  id String @id @default(uuid())
  userId String
  refreshHash String
  persistent Boolean @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  returnTo String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, expiresAt])
}

model LegalAcceptance {
  id String @id @default(uuid())
  userId String
  termsVersion String
  privacyVersion String
  origin String
  acceptedAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, acceptedAt])
}

model AuthAttempt {
  id String @id @default(uuid())
  email String
  origin String
  action String
  createdAt DateTime @default(now())
  @@index([email, action, createdAt])
  @@index([origin, action, createdAt])
}

model WorkspaceInvite {
  id String @id @default(uuid())
  workspaceId String
  email String
  role WorkspaceRole
  tokenHash String @unique
  senderId String
  recipientId String?
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  deliveryError String?
  lastSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  sender User @relation("inviteSender",fields:[senderId],references:[id],onDelete:Cascade)
  recipient User? @relation("inviteRecipient",fields:[recipientId],references:[id],onDelete:SetNull)
  @@index([workspaceId, email])
  @@index([email, expiresAt])
}
model WorkspaceMember {
  workspaceId String
  userId String
  role WorkspaceRole @default(EDITOR)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([workspaceId,userId])
}
model Project {
  id String @id @default(uuid())
  workspaceId String
  name String
  key String
  requirementSequence Int @default(0)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  requirements Requirement[]
  dependencyAnalyses DependencyAnalysis[]
  googleDriveFolderLinks GoogleDriveFolderLink[]
  @@unique([workspaceId,key])
}
model Requirement {
  id String @id @default(uuid())
  projectId String
  code String
  type RequirementType
  title String
  content Json
  status RequirementStatus @default(DRAFT)
  folderId String
  source String @default("MANUAL")
  revision Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  folder RequirementFolder @relation(fields:[folderId],references:[id],onDelete:Restrict)
  criteria AcceptanceCriterion[]
  versions RequirementVersion[]
  outgoing RequirementRelation[] @relation("outgoing")
  incoming RequirementRelation[] @relation("incoming")
  impacts ImpactAnalysis[]
  aiSuggestions AiSuggestion[] @relation("suggestionSource")
  targetedByAiSuggestions AiSuggestion[] @relation("suggestionTarget")
  references RequirementReference[]
  commentThreads CommentThread[]
  integrationSource IntegrationSource? @relation("canonicalIntegrationSource")
  googleDriveOutbox GoogleDriveOutbox[]
  embeddingChunks RequirementEmbeddingChunk[]
  @@unique([projectId,code])
  @@index([projectId,status])
  @@index([folderId,status])
}
model RequirementFolder {
  id String @id @default(uuid())
  workspaceId String
  name String
  description String?
  parentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  parent RequirementFolder? @relation("folderTree",fields:[parentId],references:[id],onDelete:Restrict)
  children RequirementFolder[] @relation("folderTree")
  requirements Requirement[]
  googleDriveFolderMappings GoogleDriveFolderMapping[]
  @@unique([workspaceId,parentId,name])
  @@index([workspaceId,parentId,name])
  @@index([workspaceId,updatedAt])
}
model AcceptanceCriterion {
  id String @id @default(uuid())
  requirementId String
  text String
  title String?
  given String?
  whenText String? @map("when")
  thenText String? @map("then")
  content Json?
  position Int
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  @@unique([requirementId,position])
}
model RequirementReference {
  id String @id @default(uuid())
  requirementId String
  type ReferenceType
  name String
  url String
  position Int @default(0)
  createdAt DateTime @default(now())
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  @@index([requirementId,type,position])
}
model DocumentTemplate {
  id String @id @default(uuid())
  workspaceId String
  name String
  description String?
  content Json
  acceptanceCriteria Json?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  @@unique([workspaceId,name])
  @@index([workspaceId,updatedAt])
}
model CommentThread {
  id String @id @default(uuid())
  requirementId String
  authorId String
  anchor Json?
  status CommentThreadStatus @default(OPEN)
  resolvedAt DateTime?
  resolvedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  author User @relation("commentThreadAuthor",fields:[authorId],references:[id],onDelete:Cascade)
  resolvedBy User? @relation("commentThreadResolver",fields:[resolvedById],references:[id],onDelete:SetNull)
  messages CommentMessage[]
  @@index([requirementId,status,createdAt])
}
model CommentMessage {
  id String @id @default(uuid())
  threadId String
  authorId String
  body String
  mentionedUserIds String[] @default([])
  createdAt DateTime @default(now())
  thread CommentThread @relation(fields:[threadId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  notifications Notification[]
  @@index([threadId,createdAt])
}
model Notification {
  id String @id @default(uuid())
  userId String
  type NotificationType
  commentMessageId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  commentMessage CommentMessage? @relation(fields:[commentMessageId],references:[id],onDelete:Cascade)
  @@index([userId,readAt,createdAt])
}

/// A logical connection is retained after disconnect so source/candidate
/// history remains auditable. Credentials are nulled on disconnect.
model IntegrationConnection {
  id String @id @default(uuid())
  workspaceId String
  kind IntegrationKind
  status IntegrationStatus @default(DISCONNECTED)
  accountLabel String?
  encryptedCredentials String?
  connectedAt DateTime?
  disconnectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  sources IntegrationSource[]
  candidates IntegrationCandidate[]
  googleDriveFolderLinks GoogleDriveFolderLink[]
  @@unique([workspaceId,kind])
  @@index([workspaceId,status])
}

model IntegrationSource {
  id String @id @default(uuid())
  connectionId String
  externalId String
  name String
  mimeType String?
  capturedAt DateTime @default(now())
  externalVersion String?
  lastSeenAt DateTime @default(now())
  removedAt DateTime?
  googleDriveFolderLinkId String?
  canonicalRequirementId String? @unique
  lastRemoteFingerprint String?
  lastPushedFingerprint String?
  lastRemoteModifiedAt DateTime?
  connection IntegrationConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  googleDriveFolderLink GoogleDriveFolderLink? @relation(fields:[googleDriveFolderLinkId],references:[id],onDelete:SetNull)
  canonicalRequirement Requirement? @relation("canonicalIntegrationSource",fields:[canonicalRequirementId],references:[id],onDelete:SetNull)
  candidates IntegrationCandidate[]
  googleDriveOutbox GoogleDriveOutbox[]
  googleDriveSyncRunItems GoogleDriveSyncRunItem[]
  @@unique([connectionId,externalId])
  @@index([connectionId,capturedAt])
  @@index([googleDriveFolderLinkId,removedAt])
}

model GoogleDriveFolderLink {
  id String @id @default(uuid())
  connectionId String
  projectId String?
  externalId String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSyncedAt DateTime?
  syncStartedAt DateTime?
  syncStatus GoogleSyncStatus @default(IDLE)
  syncError String?
  connection IntegrationConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  sources IntegrationSource[]
  folderMappings GoogleDriveFolderMapping[]
  googleDriveOutbox GoogleDriveOutbox[]
  syncRuns GoogleDriveSyncRun[]
  @@unique([connectionId,externalId])
  @@index([connectionId,updatedAt])
  @@index([projectId,syncStatus])
}

/// One durable execution of a linked Google Drive folder. It is separate from
/// the link's current status so the integration audit can retain history.
model GoogleDriveSyncRun {
  id String @id @default(uuid())
  googleDriveFolderLinkId String
  status GoogleSyncStatus @default(RUNNING)
  startedAt DateTime @default(now())
  completedAt DateTime?
  scannedCount Int @default(0)
  changedCount Int @default(0)
  error String?
  googleDriveFolderLink GoogleDriveFolderLink @relation(fields:[googleDriveFolderLinkId],references:[id],onDelete:Cascade)
  items GoogleDriveSyncRunItem[]
  @@index([googleDriveFolderLinkId,startedAt])
}

/// Compact immutable audit entry; document content remains in the candidate
/// and revision models instead of being duplicated at every poll.
model GoogleDriveSyncRunItem {
  id String @id @default(uuid())
  googleDriveSyncRunId String
  candidateId String?
  sourceId String?
  externalId String
  title String
  changeType IntegrationCandidateChangeType
  createdAt DateTime @default(now())
  googleDriveSyncRun GoogleDriveSyncRun @relation(fields:[googleDriveSyncRunId],references:[id],onDelete:Cascade)
  candidate IntegrationCandidate? @relation(fields:[candidateId],references:[id],onDelete:SetNull)
  source IntegrationSource? @relation(fields:[sourceId],references:[id],onDelete:SetNull)
  @@unique([googleDriveSyncRunId,externalId])
  @@index([googleDriveSyncRunId,createdAt])
}

/// Maps each Drive subfolder to the real nested folder shown in ATHENA.
model GoogleDriveFolderMapping {
  id String @id @default(uuid())
  googleDriveFolderLinkId String
  externalId String
  parentExternalId String?
  name String
  folderId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  googleDriveFolderLink GoogleDriveFolderLink @relation(fields:[googleDriveFolderLinkId],references:[id],onDelete:Cascade)
  folder RequirementFolder @relation(fields:[folderId],references:[id],onDelete:Cascade)
  @@unique([googleDriveFolderLinkId,externalId])
  @@unique([folderId])
  @@index([googleDriveFolderLinkId,parentExternalId])
}

/// Durable writes from ATHENA to Drive.  The poller consumes this table so a
/// successful database save never depends on an in-process HTTP request.
model GoogleDriveOutbox {
  id String @id @default(uuid())
  googleDriveFolderLinkId String
  integrationSourceId String?
  requirementId String
  operation GoogleDriveOutboxOperation
  status GoogleDriveOutboxStatus @default(PENDING)
  payload Json?
  attempts Int @default(0)
  error String?
  availableAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  googleDriveFolderLink GoogleDriveFolderLink @relation(fields:[googleDriveFolderLinkId],references:[id],onDelete:Cascade)
  integrationSource IntegrationSource? @relation(fields:[integrationSourceId],references:[id],onDelete:SetNull)
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  @@index([status,availableAt])
  @@index([googleDriveFolderLinkId,status])
}

model IntegrationCandidate {
  id String @id @default(uuid())
  connectionId String
  sourceId String?
  externalId String
  title String
  content Json
  status IntegrationCandidateStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  externalVersion String?
  fingerprint String?
  changeType IntegrationCandidateChangeType @default(CREATED)
  previousTitle String?
  previousContent Json?
  reviewedAt DateTime?
  connection IntegrationConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  source IntegrationSource? @relation(fields:[sourceId],references:[id],onDelete:SetNull)
  revisions IntegrationCandidateRevision[]
  googleDriveSyncRunItems GoogleDriveSyncRunItem[]
  @@unique([connectionId,externalId])
  @@index([connectionId,status])
}

/// Immutable snapshots make external diffs auditable without replacing the canonical US.
model IntegrationCandidateRevision {
  id String @id @default(uuid())
  candidateId String
  externalVersion String?
  title String
  content Json
  fingerprint String
  capturedAt DateTime @default(now())
  candidate IntegrationCandidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
  @@unique([candidateId, fingerprint])
  @@index([candidateId, capturedAt])
}

/// Short-lived, one-use OAuth state bound to the initiating user/workspace.
model GoogleOAuthState {
  id String @id @default(uuid())
  stateHash String @unique
  workspaceId String
  userId String
  redirectUri String
  scopes String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([workspaceId, expiresAt])
  @@index([stateHash, usedAt, expiresAt])
}
model RequirementVersion {
  id String @id @default(uuid())
  requirementId String
  revision Int
  snapshot Json
  createdAt DateTime @default(now())
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  @@unique([requirementId,revision])
}
model RequirementRelation {
  id String @id @default(uuid())
  sourceId String
  targetId String
  type RelationType
  createdAt DateTime @default(now())
  source Requirement @relation("outgoing",fields:[sourceId],references:[id],onDelete:Cascade)
  target Requirement @relation("incoming",fields:[targetId],references:[id],onDelete:Cascade)
  @@unique([sourceId,targetId,type])
}
/// Searchable excerpts used only by dependency retrieval. The vector column is
/// pgvector-native so Prisma accesses it through parameterized raw SQL.
model RequirementEmbeddingChunk {
  id String @id @default(uuid())
  requirementId String
  ordinal Int
  content String
  contentHash String
  embeddingModel String
  embedding Unsupported("vector(768)")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  @@unique([requirementId, ordinal, embeddingModel])
  @@index([requirementId, embeddingModel])
}
model ActivityLog {
  id String @id @default(uuid())
  userId String
  projectId String
  action String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([projectId,createdAt])
}
model ImpactAnalysis {
  id String @id @default(uuid())
  requirementId String
  status ImpactStatus @default(PENDING)
  error String?
  createdAt DateTime @default(now())
  requirement Requirement @relation(fields:[requirementId],references:[id],onDelete:Cascade)
  items ImpactItem[]
  suggestions AiSuggestion[]
  @@unique([requirementId])
}
model ImpactItem {
  id String @id @default(uuid())
  analysisId String
  targetRequirementId String
  severity String
  rationale String
  decision ImpactDecision @default(PENDING)
  suggestedRelationType RelationType?
  analysis ImpactAnalysis @relation(fields:[analysisId],references:[id],onDelete:Cascade)
  @@unique([analysisId,targetRequirementId])
}

/// Provider proposals remain separate from historical ImpactItem rows. An
/// approval can create a canonical relation/reference, but persistence of a
/// suggestion never changes the requirement document itself.
model AiSuggestion {
  id String @id @default(uuid())
  /// Legacy per-requirement analysis. New dependency proposals belong to a
  /// project-wide DependencyAnalysis instead.
  analysisId String?
  dependencyAnalysisId String?
  requirementId String
  type AiSuggestionType
  targetRequirementId String?
  relationType RelationType?
  referenceType ReferenceType?
  url String?
  confidence Float?
  justification String
  status AiSuggestionStatus @default(PENDING)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analysis ImpactAnalysis? @relation(fields:[analysisId],references:[id],onDelete:Cascade)
  dependencyAnalysis DependencyAnalysis? @relation(fields:[dependencyAnalysisId],references:[id],onDelete:Cascade)
  requirement Requirement @relation("suggestionSource",fields:[requirementId],references:[id],onDelete:Cascade)
  targetRequirement Requirement? @relation("suggestionTarget",fields:[targetRequirementId],references:[id],onDelete:Cascade)
  @@index([analysisId,status])
  @@index([dependencyAnalysisId,status])
  @@index([requirementId,status])
  @@index([targetRequirementId])
}

/// An immutable record of one project-wide AI pass. Suggestions attached to
/// it remain reviewable after the pass finishes; only pending suggestions are
/// replaced when the next pass begins.
model DependencyAnalysis {
  id String @id @default(uuid())
  projectId String
  status DependencyAnalysisStatus @default(QUEUED)
  totalRequirements Int @default(0)
  processedRequirements Int @default(0)
  suggestionsFound Int @default(0)
  error String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  suggestions AiSuggestion[]
  @@index([projectId,createdAt])
  @@index([projectId,status])
}
