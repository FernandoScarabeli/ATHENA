# Copy to .env.demo. Never commit real secrets or a real tunnel URL.
NETLIFY_SITE_ORIGIN=https://your-site.netlify.app
APP_ORIGIN=https://your-site.netlify.app
# Resend sender and legal pages are required by the production API.
RESEND_API_KEY=
RESEND_FROM=ATHENA <acesso@seu-dominio-verificado.com>
TERMS_URL=https://your-site.netlify.app/termos
PRIVACY_URL=https://your-site.netlify.app/privacidade
TERMS_VERSION=1
PRIVACY_VERSION=1
FUNNEL_API_PORT=3000
FUNNEL_HTTPS_PORT=443
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Generate with: openssl rand -base64 32. Keep this on the API host only;
# it is not a Netlify variable.
INTEGRATION_ENCRYPTION_KEY=
