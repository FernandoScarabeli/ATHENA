APP_NAME=ATHENA
NODE_ENV=development
DATABASE_URL=postgresql://athena:athena@postgres:5432/athena?schema=public
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
# Resend transactional e-mail. Configure a domain/remetente verificado no Resend.
APP_ORIGIN=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=ATHENA <acesso@seu-dominio.com>
TERMS_URL=https://example.com/termos
PRIVACY_URL=https://example.com/privacidade
VITE_TERMS_URL=https://example.com/termos
VITE_PRIVACY_URL=https://example.com/privacidade
TERMS_VERSION=1
PRIVACY_VERSION=1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_TIMEOUT_MS=15000
AI_PROVIDER=disabled
# Gere uma chave base64 de 32 bytes; obrigatório para iniciar a API.
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/oauth/callback
CLOUDFLARE_TUNNEL_TOKEN=
