APP_NAME=ATHENA
NODE_ENV=development
DATABASE_URL=postgresql://athena:athena@postgres:5432/athena?schema=public
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
AI_PROVIDER=ollama
INTEGRATION_ENCRYPTION_KEY=base64-encoded-32-byte-key
CLOUDFLARE_TUNNEL_TOKEN=
