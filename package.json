{
  "name": "requirements-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20.19", "pnpm": ">=9" },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @athena/api --filter @athena/web dev",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "demo:on": "sh scripts/demo-on.sh",
    "demo:off": "sh scripts/demo-off.sh",
    "demo:status": "sh scripts/demo-status.sh",
    "deploy": "./deploy/deploy.sh",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "lint": "corepack pnpm -r lint",
    "db:generate": "corepack pnpm --filter @athena/api exec prisma generate",
    "db:migrate": "corepack pnpm --filter @athena/api exec prisma migrate dev"
  }
}
